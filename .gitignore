# ==============================
# Python virtual environments
# ==============================
.venv/
venv/
env/

# ==============================
# Python cache
# ==============================
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ==============================
# IDE and editor
# ==============================
.vscode/
.idea/
*.swp
*.swo

# ==============================
# Environment variables / secrets
# ==============================
.env
.env.*
!.env.example

# ==============================
# Logs and temporary files
# ==============================
*.log
*.tmp
*.temp
*.bak
.DS_Store

# ==============================
# Backups
# ==============================
backups/

# ==============================
# Jupyter
# ==============================
.ipynb_checkpoints/

# ==============================
# Experiment outputs
# ==============================
outputs/*/logs/
outputs/*/tensorboard/
runs/
wandb/

# ==============================
# Generated Python artifacts
# ==============================
build/
dist/
*.egg-info/

# ==============================
# SUMO temporary files
# ==============================
*.netstate
*.tripinfo.xml
*.emission.xml
*.fcd.xml
*.vehroute.xml
*.summary.xml


# ==============================
# Phase 2: bulk generated marketplace data (regenerable from config + seed)
# Kept in git: configs, frozen config, manifests, stats, validation/reproducibility reports
# ==============================
data/synthetic/marketplace/*/*/
data/derived/connectivity/*/*.csv.gz

# Building geometry derived from OSM via polyconvert (regenerable; manifest kept in git)
data/derived/geometry/*.poly.xml

# Phase 3 bulk outputs (regenerable from config + seeds; manifests/stats/reports kept)
data/derived/phase3_cache/*/*.csv.gz
data/simulation/phase3/*/*/

# Phase 4 bulk outputs (regenerable; manifests/metrics/reports kept)
data/allocation/phase4/*/*/
